# Cloudflare Workers Assets / Pages headers file.
# Format: https://developers.cloudflare.com/pages/configuration/headers/
#
# Cache strategy: blog filenames are NOT content-hashed, so `immutable` is
# only safe for paths whose contents truly never change (e.g. favicons).
# Everything else uses a finite TTL with revalidation so a replaced asset
# eventually reaches returning visitors.

# All images (incl. favicons) — 30d cache, quiet background revalidation.
# Note: a separate `/images/favicons/*` immutable rule would be ideal, but
# Cloudflare's `*` glob matches across slashes, so both rules fire and the
# Cache-Control values get concatenated. 30d is plenty for favicons too.
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Site-level JS (scripts.js, common.js) — may be edited; 1 day with revalidation
/js/*
  Cache-Control: public, max-age=86400, must-revalidate

# Everything under /assets/ (only js/dist/* exists today) — 1d revalidate.
# Single rule because Cloudflare's `*` matches across slashes, so a separate
# /assets/js/* rule would just concatenate with this one.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate
